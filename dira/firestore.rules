rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isMember(clinicId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/clinics/$(clinicId)/members/$(request.auth.uid));
    }

    function isAdmin(clinicId) {
      return isMember(clinicId) &&
        get(/databases/$(database)/documents/clinics/$(clinicId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    // Explicit rule to allow collection-group queries across all invites
    match /{path=**}/invites/{inviteId} {
      allow read: if request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /clinics/{clinicId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update: if isAdmin(clinicId);
      allow delete: if isAdmin(clinicId);

      match /members/{memberId} {
        allow read: if isMember(clinicId);
        allow create: if request.auth != null && request.auth.uid == memberId;
        allow update, delete: if isAdmin(clinicId);
      }

      match /invites/{inviteId} {
        allow read: if request.auth != null;
        allow create: if isAdmin(clinicId);
        allow update: if request.auth != null;
        allow delete: if isAdmin(clinicId);
      }

      match /tickets/{ticketId} {
        allow read, create, update, delete: if isMember(clinicId);
        match /comments/{commentId} {
          allow read, create: if isMember(clinicId);
          allow delete: if isMember(clinicId);
        }
      }

      match /notices/{noticeId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update: if request.auth != null;
        allow delete: if isAdmin(clinicId);
      }

      match /notifications/{notifId} {
        allow read, update: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin(clinicId));
        allow create: if isMember(clinicId);
        allow delete: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin(clinicId));
      }

    }
  }
}